# T0102: copy to the repository-root .env for local Django development.
# Replace placeholders locally; never commit real secrets.
# Local settings load .env without overriding existing environment variables.
# Production reads process environment only; do not use these development values.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=commodity_platform
POSTGRES_USER=commodity_platform
POSTGRES_PASSWORD=replace-with-your-local-database-password

# MinIO / S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_DEFAULT_BUCKET=commodity-platform
