# Copy to the repository-root .env for local Django and Docker Compose.
# Replace placeholders locally; never commit real secrets.
# Local settings load .env without overriding existing environment variables.
# Production reads process environment only; do not use these development values.
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
DJANGO_DEBUG=true

# Frontend public configuration lives in apps/web/.env.example.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Exact browser origins accepted by the local Next.js proxy; production must
# configure its own origin(s), never copy these development values.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEMO_PERSONA_SWITCHER_ENABLED=false

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=commodity_platform
POSTGRES_USER=commodity_platform
POSTGRES_PASSWORD=replace-with-your-local-database-password

# Local MinIO credentials only; application storage integration is future work.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
